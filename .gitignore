# Generated working files. weights.json is the fitted model calibrate.py writes
# and run.py/backtest.py read; alert.json is the pending webhook message run.py
# stages for send_alerts.py. Both are regenerated every run and neither belongs
# in the history — one `git add .` after following the README used to commit
# the model file into the repo root.
weights.json
alert.json


# The two large reductions of the price history. Rebuilt from scratch every run
# and published to the `site-data` branch (one force-pushed commit) instead of
# master, so they stop adding ~1.3 MB a day to the history. Netlify's build
# downloads them via public/data/site-data.json; `python
# scripts/fetch_site_data.py` does the same for a local checkout.
public/data/charts.json
public/data/weekly.json
